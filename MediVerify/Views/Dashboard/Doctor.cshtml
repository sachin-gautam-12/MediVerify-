@model DoctorDashboardViewModel
@{
    ViewData["Title"] = "Doctor Dashboard";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Doctor dashboard</h1>
        <p class="text-muted mb-0">Your patients, prescriptions and recent activity.</p>
    </div>
    <a class="btn btn-primary" href="/Prescription/Create"><i class="bi bi-plus-lg me-1"></i>New prescription</a>
</div>
<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <div class="card kpi-card p-3"><div class="kpi-label">My patients</div><div class="kpi-value">@Model.MyPatients.Count</div><i class="bi bi-people kpi-icon"></i></div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card kpi-card gradient-2 p-3"><div class="kpi-label">Drafts</div><div class="kpi-value">@Model.DraftCount</div><i class="bi bi-pencil-square kpi-icon"></i></div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card kpi-card gradient-3 p-3"><div class="kpi-label">Awaiting review</div><div class="kpi-value">@Model.SubmittedCount</div><i class="bi bi-hourglass-split kpi-icon"></i></div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card kpi-card gradient-4 p-3"><div class="kpi-label">Dispensed</div><div class="kpi-value">@Model.DispensedCount</div><i class="bi bi-check2-circle kpi-icon"></i></div>
    </div>
</div>
<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between"><span>Prescriptions per day</span><span class="text-muted small">Last 14 days</span></div>
            <div class="card-body"><canvas id="doctorLine" height="110"></canvas></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">Status breakdown</div>
            <div class="card-body"><canvas id="doctorStatus" height="180"></canvas></div>
        </div>
    </div>
</div>
<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center"><span>Recent prescriptions</span><a class="small" href="/Prescription">View all</a></div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th>Number</th><th>Patient</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                    @if (!Model.MyPrescriptions.Any())
                    {
                        <tr><td colspan="4"><div class="empty-state"><i class="bi bi-file-medical"></i>No prescriptions yet.</div></td></tr>
                    }
                    @foreach (var rx in Model.MyPrescriptions.Take(6))
                    {
                        <tr>
                            <td class="fw-semibold">@rx.PrescriptionNumber</td>
                            <td>@(rx.Patient?.ApplicationUser?.FullName ?? "—")</td>
                            <td><partial name="_StatusBadge" model="rx.Status" /></td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/Prescription/Details/@rx.PrescriptionId">View</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center"><span>My patients</span><a class="small" href="/Patients">View all</a></div>
            <div class="list-group list-group-flush">
                @if (!Model.MyPatients.Any())
                {
                    <div class="empty-state py-4"><i class="bi bi-people"></i>No patients linked yet.</div>
                }
                @foreach (var p in Model.MyPatients.Take(6))
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div><div class="fw-semibold">@(p.ApplicationUser?.FullName ?? "—")</div><div class="small text-muted">@p.Gender · @p.DateOfBirth.ToString("dd MMM yyyy")</div></div>
                        <a class="btn btn-sm btn-outline-secondary" href="/Patients/Details/@p.PatientId">View</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@section Scripts {
<script>
    const doctorColors = ['#0d9488', '#2563eb', '#f59e0b', '#ef4444', '#10b981'];
    new Chart(document.getElementById('doctorLine'), {
        type: 'line',
        data: { labels: @Html.Raw(JsonSerializer.Serialize(Model.PrescriptionsPerDay.Labels)), datasets: [{ label: 'Prescriptions', data: @Html.Raw(JsonSerializer.Serialize(Model.PrescriptionsPerDay.Values)), borderColor: '#0d9488', backgroundColor: 'rgba(13,148,136,.12)', fill: true, tension: .35 }] },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
    });
    new Chart(document.getElementById('doctorStatus'), {
        type: 'doughnut',
        data: { labels: @Html.Raw(JsonSerializer.Serialize(Model.StatusBreakdown.Labels)), datasets: [{ data: @Html.Raw(JsonSerializer.Serialize(Model.StatusBreakdown.Values)), backgroundColor: doctorColors }] },
        options: { plugins: { legend: { position: 'bottom' } }, cutout: '62%' }
    });
</script>
}
