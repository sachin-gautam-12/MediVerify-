@model PatientDashboardViewModel
@{
    ViewData["Title"] = "Patient Dashboard";
    var next = Model.Prescriptions.FirstOrDefault(p => p.Status == "Verified" || p.Status == "Submitted");
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">My health dashboard</h1>
        <p class="text-muted mb-0">Track your prescriptions and collect your medicines.</p>
    </div>
    <a class="btn btn-primary" href="/Prescription"><i class="bi bi-file-medical me-1"></i>My prescriptions</a>
</div>

@if (next != null)
{
    <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <i class="bi bi-info-circle me-1"></i>
            <strong>@next.PrescriptionNumber</strong> is <partial name="_StatusBadge" model="next.Status" />
            <span class="ms-1">@(next.Status == "Verified" ? "Your medicines are ready to be dispensed." : "A pharmacist is reviewing your prescription.")</span>
        </div>
        <a class="btn btn-sm btn-outline-primary" href="/Prescription/Details/@next.PrescriptionId">View details</a>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <div class="card kpi-card p-3">
            <div class="kpi-label">Total prescriptions</div>
            <div class="kpi-value">@Model.Prescriptions.Count</div>
            <i class="bi bi-file-medical kpi-icon"></i>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card kpi-card gradient-2 p-3">
            <div class="kpi-label">In progress</div>
            <div class="kpi-value">@Model.ActiveCount</div>
            <i class="bi bi-hourglass-split kpi-icon"></i>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card kpi-card gradient-4 p-3">
            <div class="kpi-label">Dispensed</div>
            <div class="kpi-value">@Model.DispensedCount</div>
            <i class="bi bi-check2-circle kpi-icon"></i>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card kpi-card gradient-3 p-3">
            <div class="kpi-label">Notifications</div>
            <div class="kpi-value">@Model.Notifications.Count(n => !n.IsRead)</div>
            <i class="bi bi-bell kpi-icon"></i>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Recent prescriptions</span>
                <a class="small" href="/Prescription">View all</a>
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th>Number</th><th>Doctor</th><th>Status</th><th>Date</th><th class="text-end"></th></tr></thead>
                    <tbody>
                    @if (!Model.Prescriptions.Any())
                    {
                        <tr><td colspan="5"><div class="empty-state"><i class="bi bi-file-medical"></i>No prescriptions yet. They will appear here after your doctor creates one.</div></td></tr>
                    }
                    @foreach (var rx in Model.Prescriptions.Take(6))
                    {
                        <tr>
                            <td class="fw-semibold">@rx.PrescriptionNumber</td>
                            <td>@(rx.Doctor?.FullName ?? "—")</td>
                            <td><partial name="_StatusBadge" model="rx.Status" /></td>
                            <td class="text-muted">@rx.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" href="/Prescription/Details/@rx.PrescriptionId">View</a>
                                @if (rx.Status == "Dispensed")
                                {
                                    <a class="btn btn-sm btn-outline-success" href="/Prescription/Receipt/@rx.PrescriptionId">Receipt</a>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card">
            <div class="card-header">Prescription status</div>
            <div class="card-body"><canvas id="patientStatus" height="110"></canvas></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">Quick actions</div>
            <div class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="/Prescription">My prescriptions <i class="bi bi-chevron-right"></i></a>
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="/Profile">Edit my profile <i class="bi bi-chevron-right"></i></a>
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="/Notification">Notifications <i class="bi bi-chevron-right"></i></a>
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="/Account/ChangePassword">Change password <i class="bi bi-chevron-right"></i></a>
            </div>
        </div>
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Latest notifications</span>
                <a class="small" href="/Notification">All</a>
            </div>
            <div class="list-group list-group-flush">
                @if (!Model.Notifications.Any())
                {
                    <div class="empty-state py-4"><i class="bi bi-bell-slash"></i>No notifications yet.</div>
                }
                @foreach (var n in Model.Notifications)
                {
                    <a class="list-group-item list-group-item-action" href="/Notification">
                        <div class="d-flex justify-content-between gap-2">
                            <strong class="small">@n.Title</strong>
                            <small class="text-muted">@n.CreatedAt.ToLocalTime().ToString("dd MMM")</small>
                        </div>
                        <div class="small text-muted text-truncate">@n.Message</div>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const patientColors = ['#0d9488', '#2563eb', '#f59e0b', '#ef4444', '#10b981'];
    new Chart(document.getElementById('patientStatus'), {
        type: 'bar',
        data: { labels: @Html.Raw(JsonSerializer.Serialize(Model.StatusBreakdown.Labels)), datasets: [{ label: 'Prescriptions', data: @Html.Raw(JsonSerializer.Serialize(Model.StatusBreakdown.Values)), backgroundColor: patientColors, borderRadius: 6 }] },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
    });
</script>
}
