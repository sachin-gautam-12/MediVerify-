@{
    var code = ViewData["StatusCode"] ?? 500;
}
<div class="container py-4">
<div class="row justify-content-center align-items-center" style="min-height:60vh">
    <div class="col-md-7 text-center">
        <div class="display-1 fw-bold text-primary">@code</div>
        <h1 class="h3 mt-2">@ViewData["Title"]</h1>
        <p class="text-muted">@ViewData["Message"]</p>
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn btn-outline-secondary" href="/Dashboard">Go to dashboard</a>
    </div>
</div>
</div>
