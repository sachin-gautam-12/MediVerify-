@{
    ViewData["Title"] = "Reports";
}
<div class="mb-3">
    <h1 class="h3 mb-1">Reports</h1>
    <p class="text-muted mb-0">Export prescription data for offline analysis.</p>
</div>
<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="bi bi-file-earmark-pdf display-5 text-danger"></i>
                <h5 class="mt-3">PDF report</h5>
                <p class="text-muted small">A printable prescription register.</p>
                <a class="btn btn-outline-danger" href="/Reports/Pdf"><i class="bi bi-download me-1"></i>Download PDF</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="bi bi-file-earmark-excel display-5 text-success"></i>
                <h5 class="mt-3">Excel report</h5>
                <p class="text-muted small">One row per prescribed medicine.</p>
                <a class="btn btn-outline-success" href="/Reports/Excel"><i class="bi bi-download me-1"></i>Download Excel</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="bi bi-filetype-csv display-5 text-primary"></i>
                <h5 class="mt-3">CSV export</h5>
                <p class="text-muted small">Raw data for any spreadsheet tool.</p>
                <a class="btn btn-outline-primary" href="/Reports/Csv"><i class="bi bi-download me-1"></i>Download CSV</a>
            </div>
        </div>
    </div>
</div>
