<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - MediVerify</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-3">
        <div class="container">
            <a class="navbar-brand" href="/">MediVerify</a>
            <div class="navbar-nav">
                <a class="nav-link" href="/">Home</a>
                <a class="nav-link" href="/Medicine">Medicines</a>
                <a class="nav-link" href="/Prescription">Prescriptions</a>
                <a class="nav-link" href="/Dashboard">Dashboard</a>
                <a class="nav-link" href="/Account/Login">Login</a>
                <a class="nav-link" href="/Account/Register">Register</a>
                <form method="post" action="/Account/Logout" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-link nav-link" type="submit">Logout</button></form>
            </div>
        </div>
    </nav>
    <div class="container">
        @RenderBody()
    </div>
</body>
</html>