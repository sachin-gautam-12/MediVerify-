@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var currentUser = isAuth ? await UserManager.GetUserAsync(User) : null;
    var displayName = currentUser?.FullName ?? User.Identity?.Name ?? "Guest";
    var role = User.IsInRole("Administrator") ? "Administrator"
             : User.IsInRole("Doctor") ? "Doctor"
             : User.IsInRole("Pharmacist") ? "Pharmacist"
             : User.IsInRole("Patient") ? "Patient" : "";
    var initials = string.Join("", displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpper();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · MediVerify</title>
    <link rel="icon" type="image/svg+xml" href="~/img/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
@if (isAuth)
{
    <div class="mv-shell">
        <aside class="mv-sidebar">
            <a class="mv-sidebar-brand" href="/Dashboard">
                <img src="~/img/logo.svg" width="34" height="34" alt="" />
                <span>MediVerify</span>
            </a>
            <div class="nav-section">Main</div>
            <nav class="nav flex-column">
                <a class="nav-link @(controller == "Dashboard" ? "active" : "")" href="/Dashboard"><i class="bi bi-grid-1x2"></i> Dashboard</a>
                @if (role == "Doctor")
                {
                    <a class="nav-link @(controller == "Prescription" ? "active" : "")" href="/Prescription"><i class="bi bi-file-medical"></i> My Prescriptions</a>
                    <a class="nav-link @(controller == "Patients" ? "active" : "")" href="/Patients"><i class="bi bi-people"></i> My Patients</a>
                }
                @if (role == "Pharmacist")
                {
                    <a class="nav-link @(controller == "Prescription" ? "active" : "")" href="/Prescription/Queue"><i class="bi bi-clipboard2-check"></i> Verification Queue</a>
                    <a class="nav-link @(controller == "Inventory" ? "active" : "")" href="/Inventory"><i class="bi bi-box-seam"></i> Inventory</a>
                    <a class="nav-link @(controller == "SafetyAlert" ? "active" : "")" href="/SafetyAlert"><i class="bi bi-shield-exclamation"></i> Safety Alerts</a>
                }
                @if (role == "Administrator")
                {
                    <a class="nav-link @(controller == "Medicine" ? "active" : "")" href="/Medicine"><i class="bi bi-capsule"></i> Medicines</a>
                    <a class="nav-link @(controller == "Inventory" ? "active" : "")" href="/Inventory"><i class="bi bi-box-seam"></i> Inventory</a>
                    <a class="nav-link @(controller == "UserAdmin" ? "active" : "")" href="/UserAdmin"><i class="bi bi-person-gear"></i> Users</a>
                    <a class="nav-link @(controller == "SafetyAlert" ? "active" : "")" href="/SafetyAlert"><i class="bi bi-shield-exclamation"></i> Safety Alerts</a>
                    <a class="nav-link @(controller == "Audit" ? "active" : "")" href="/Audit"><i class="bi bi-journal-text"></i> Audit Log</a>
                    <a class="nav-link @(controller == "Reports" ? "active" : "")" href="/Reports"><i class="bi bi-bar-chart"></i> Reports</a>
                }
                @if (role == "Patient")
                {
                    <a class="nav-link @(controller == "Prescription" ? "active" : "")" href="/Prescription"><i class="bi bi-file-medical"></i> My Prescriptions</a>
                    <a class="nav-link @(controller == "Profile" ? "active" : "")" href="/Profile"><i class="bi bi-person"></i> My Profile</a>
                }
                <a class="nav-link @(controller == "Notification" ? "active" : "")" href="/Notification"><i class="bi bi-bell"></i> Notifications</a>
            </nav>
            <div class="nav-section">Account</div>
            <nav class="nav flex-column">
                <a class="nav-link" href="/Account/ChangePassword"><i class="bi bi-key"></i> Change Password</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="px-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-link border-0 bg-transparent w-100 text-start"><i class="bi bi-box-arrow-right"></i> Sign out</button>
                </form>
            </nav>
            <div class="mv-sidebar-footer">
                <div class="fw-semibold text-white">@displayName</div>
                <div>@role</div>
            </div>
        </aside>
        <div class="mv-sidebar-backdrop"></div>
        <div class="mv-main">
            <header class="mv-topbar">
                <button class="btn btn-icon btn-outline-secondary d-lg-none" onclick="toggleSidebar()" type="button" aria-label="Menu"><i class="bi bi-list"></i></button>
                <form class="search-box d-none d-md-block" method="get" action="/Prescription/Search">
                    <i class="bi bi-search"></i>
                    <input class="form-control" name="q" placeholder="Search prescriptions, patients…" />
                </form>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <button class="btn btn-icon btn-outline-secondary" onclick="toggleTheme()" type="button" title="Toggle dark mode"><i class="bi bi-moon-stars" data-theme-icon></i></button>
                    @await Component.InvokeAsync("NotificationBell")
                    <div class="dropdown">
                        <button class="btn d-flex align-items-center gap-2 border-0" data-bs-toggle="dropdown" type="button">
                            <span class="mv-avatar">@initials</span>
                            <span class="d-none d-md-block text-start">
                                <span class="d-block fw-semibold" style="font-size:.85rem">@displayName</span>
                                <span class="d-block text-muted" style="font-size:.72rem">@role</span>
                            </span>
                            <i class="bi bi-chevron-down small"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li><a class="dropdown-item" href="/Dashboard"><i class="bi bi-grid me-2"></i>Dashboard</a></li>
                            @if (role == "Patient")
                            {
                                <li><a class="dropdown-item" href="/Profile"><i class="bi bi-person me-2"></i>My profile</a></li>
                            }
                            <li><a class="dropdown-item" href="/Account/ChangePassword"><i class="bi bi-key me-2"></i>Change password</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>
            <main class="mv-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show alert-auto-dismiss" role="alert">
                        <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show alert-auto-dismiss" role="alert">
                        <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="/">
                <img src="~/img/logo.svg" width="30" height="30" alt="" /> MediVerify
            </a>
            <div class="ms-auto d-flex gap-2">
                <a class="btn btn-outline-primary" href="/Account/Login">Login</a>
                <a class="btn btn-primary" href="/Account/Register">Register</a>
            </div>
        </div>
    </nav>
    <main>
        @RenderBody()
    </main>
}
<script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
<script src="~/lib/chartjs/chart.umd.min.js"></script>
<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
