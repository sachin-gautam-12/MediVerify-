@{
    ViewData["Title"] = "Privacy";
}
<div class="container py-4">
<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="mb-4">
            <h1 class="h3 mb-1">Privacy policy</h1>
            <p class="text-muted mb-0">How MediVerify handles prescription and account data in this demo.</p>
        </div>
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h6">What we store</h2>
                <p class="text-muted mb-3">Account details (name, email, phone), patient demographics, prescriptions and their medicines, dispensing records, safety alerts and audit events.</p>
                <h2 class="h6">Who can see it</h2>
                <ul class="text-muted mb-3">
                    <li>Doctors see only the prescriptions they wrote and their linked patients.</li>
                    <li>Pharmacists see submitted, verified and dispensed prescriptions they must action.</li>
                    <li>Patients see only their own prescriptions and profile.</li>
                    <li>Administrators manage the catalogue and can review audit events and reports.</li>
                </ul>
                <h2 class="h6">Audit and retention</h2>
                <p class="text-muted mb-0">Every sensitive action writes an audit record with the acting user, action, entity, timestamp and originating IP address. This demo stores data in a local SQL Server Express database.</p>
            </div>
        </div>
        <a class="btn btn-outline-secondary" href="/">Back to home</a>
    </div>
</div>
</div>
