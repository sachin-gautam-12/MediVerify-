@model InventoryViewModel
@{
    ViewData["Title"] = "Adjust Stock";
    var id = ViewContext.RouteData.Values["id"];
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="h3 mb-1">Adjust stock</h1><p class="text-muted mb-0">@ViewBag.MedicineName</p></div>
    <a class="btn btn-outline-secondary" href="/Inventory">Back</a>
</div>
<div class="card">
    <div class="card-body">
        <form asp-action="Adjust" asp-route-id="@id" method="post" data-spinner>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <input type="hidden" asp-for="InventoryId" />
            <input type="hidden" asp-for="MedicineId" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="AvailableQuantity" class="form-label">Available quantity</label>
                    <input asp-for="AvailableQuantity" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="ReorderLevel" class="form-label">Reorder level</label>
                    <input asp-for="ReorderLevel" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="ExpiryDate" class="form-label">Expiry date</label>
                    <input asp-for="ExpiryDate" type="date" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="BatchNumber" class="form-label">Batch number</label>
                    <input asp-for="BatchNumber" class="form-control" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-3"><i class="bi bi-save me-1"></i>Save changes</button>
        </form>
    </div>
</div>
