@model Medicine
@{
    ViewData["Title"] = "Medicine Details";
}
<h2>@Model.MedicineName</h2>
<dl class="row">
    <dt class="col-sm-3">Generic Name</dt><dd class="col-sm-9">@Model.GenericName</dd>
    <dt class="col-sm-3">Manufacturer</dt><dd class="col-sm-9">@Model.Manufacturer</dd>
    <dt class="col-sm-3">Category</dt><dd class="col-sm-9">@Model.Category</dd>
    <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd>
    <dt class="col-sm-3">Active</dt><dd class="col-sm-9">@Model.IsActive</dd>
</dl>
<p><a href="/Medicine">Back</a></p>