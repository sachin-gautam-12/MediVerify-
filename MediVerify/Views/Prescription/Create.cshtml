@model PrescriptionCreateViewModel
@{
    ViewData["Title"] = "Create Prescription";
    var patients = ViewBag.Patients as List<Patient> ?? new List<Patient>();
    var medicines = ViewBag.Medicines as List<Medicine> ?? new List<Medicine>();
}
<h2>Create Prescription</h2>
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="PatientId" class="form-label"></label>
        <select asp-for="PatientId" class="form-select">
            @foreach (var p in patients)
            {
                <option value="@p.PatientId">Patient @p.PatientId</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>
    <h4>Item</h4>
    <div class="mb-3">
        <label>Medicine</label>
        <select name="Items[0].MedicineId" class="form-select">
            @foreach (var m in medicines)
            {
                <option value="@m.MedicineId">@m.MedicineName</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label>Quantity</label>
        <input name="Items[0].Quantity" type="number" step="0.01" class="form-control" value="1" />
    </div>
    <div class="mb-3">
        <label>Duration (days)</label>
        <input name="Items[0].Duration" type="number" class="form-control" value="7" />
    </div>
    <div class="mb-3">
        <label>Instructions</label>
        <input name="Items[0].Instructions" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Notes</label>
        <input name="Items[0].Notes" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
</form>