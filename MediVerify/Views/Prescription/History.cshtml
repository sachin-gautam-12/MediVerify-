@model IEnumerable<Prescription>
@{
    ViewData["Title"] = "Prescription History";
    var list = Model?.ToList() ?? new List<Prescription>();
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Prescription history</h1>
        <p class="text-muted mb-0">Verified, rejected and dispensed prescriptions.</p>
    </div>
    <a class="btn btn-outline-primary" href="/Prescription/Queue"><i class="bi bi-clipboard2-check me-1"></i>Verification queue</a>
</div>
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <input class="form-control form-control-sm" style="width:260px" placeholder="Search history…" data-table-search="#historyTable" />
        <span class="text-muted small">@list.Count record(s)</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-sortable mb-0" id="historyTable" data-page-size="10">
            <thead><tr><th data-sort>Number</th><th data-sort>Patient</th><th data-sort>Status</th><th data-sort>Updated</th><th class="text-end">Action</th></tr></thead>
            <tbody>
            @if (!list.Any())
            {
                <tr><td colspan="5"><div class="empty-state"><i class="bi bi-clock-history"></i>No history yet.</div></td></tr>
            }
            @foreach (var rx in list)
            {
                <tr>
                    <td class="fw-semibold">@rx.PrescriptionNumber</td>
                    <td>@(rx.Patient?.ApplicationUser?.FullName ?? "—")</td>
                    <td><partial name="_StatusBadge" model="rx.Status" /></td>
                    <td class="text-muted">@((rx.UpdatedAt ?? rx.CreatedAt).ToLocalTime().ToString("dd MMM yyyy, HH:mm"))</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" href="/Prescription/Details/@rx.PrescriptionId"><i class="bi bi-eye"></i></a>
                        @if (rx.Status == "Dispensed")
                        {
                            <a class="btn btn-sm btn-outline-success" href="/Prescription/Receipt/@rx.PrescriptionId">Receipt</a>
                        }
                        @if (rx.Status == "Verified")
                        {
                            <a class="btn btn-sm btn-success" href="/Prescription/Dispense/@rx.PrescriptionId">Dispense</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
