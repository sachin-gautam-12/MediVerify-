@model Prescription
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@Model.PrescriptionNumber · MediVerify</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body { background:#fff; color:#0f172a; }
        .rx-sheet { max-width: 820px; margin: 24px auto; border:1px solid #e2e8f0; border-radius:16px; padding:32px; }
        .rx-header { border-bottom:2px solid #0d9488; padding-bottom:16px; margin-bottom:20px; }
        .rx-watermark { color:#0d9488; font-weight:700; letter-spacing:.08em; }
        @@media print { .no-print { display:none !important; } .rx-sheet { border:0; margin:0; padding:0; } body { font-size:12px; } }
    </style>
</head>
<body>
    <div class="no-print text-center mt-3">
        <button class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print</button>
        <a class="btn btn-outline-secondary" href="/Prescription/Details/@Model.PrescriptionId">Back</a>
    </div>
    <div class="rx-sheet">
        <div class="rx-header d-flex justify-content-between align-items-start">
            <div class="d-flex align-items-center gap-2">
                <img src="~/img/logo.svg" width="44" height="44" alt="" />
                <div>
                    <div class="h4 mb-0">MediVerify</div>
                    <div class="text-muted small">Prescription verification platform</div>
                </div>
            </div>
            <div class="text-end">
                <div class="rx-watermark">DIGITAL PRESCRIPTION</div>
                <div class="small text-muted">@Model.PrescriptionNumber</div>
                <div class="small text-muted">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
            </div>
        </div>
        <div class="row mb-4">
            <div class="col-6">
                <div class="text-muted small text-uppercase">Patient</div>
                <div class="fw-semibold">@(Model.Patient?.ApplicationUser?.FullName ?? "—")</div>
                <div class="small text-muted">DOB: @(Model.Patient?.DateOfBirth.ToString("dd MMM yyyy") ?? "—") · @Model.Patient?.Gender</div>
            </div>
            <div class="col-6 text-end">
                <div class="text-muted small text-uppercase">Prescribed by</div>
                <div class="fw-semibold">@(Model.Doctor?.FullName ?? "—")</div>
                <div class="small text-muted">@Model.Doctor?.Email</div>
            </div>
        </div>
        <table class="table">
            <thead><tr><th>Medicine</th><th>Qty</th><th>Duration</th><th>Instructions</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Items ?? new List<PrescriptionItem>())
            {
                <tr>
                    <td class="fw-semibold">@(item.Medicine?.MedicineName ?? "—")</td>
                    <td>@item.Quantity</td>
                    <td>@item.Duration days</td>
                    <td>@item.PrescribedInstructions</td>
                </tr>
            }
            </tbody>
        </table>
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="mt-3"><span class="text-muted small text-uppercase">Notes</span><div>@Model.Notes</div></div>
        }
        <div class="d-flex justify-content-between mt-5 pt-4 border-top">
            <div class="small text-muted">Status: @Model.Status</div>
            <div class="text-center small">
                <div style="border-top:1px solid #94a3b8;width:220px;padding-top:6px">Doctor signature</div>
            </div>
        </div>
        <div class="text-center small text-muted mt-4">This prescription was generated by MediVerify. Verify authenticity using the prescription number.</div>
    </div>
</body>
</html>
