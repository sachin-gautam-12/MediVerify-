@model DispensingRecord
@{
    ViewData["Title"] = "Dispensing Receipt";
    var rx = ViewBag.Prescription as Prescription;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 no-print">
    <div>
        <h1 class="h3 mb-0">Dispensing receipt</h1>
        <p class="text-muted mb-0">@rx?.PrescriptionNumber · @(rx?.Patient?.ApplicationUser?.FullName ?? "—")</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="/Prescription/Details/@rx?.PrescriptionId"><i class="bi bi-arrow-left me-1"></i>Back</a>
        <button class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print</button>
    </div>
</div>
<div class="card mx-auto" style="max-width:760px">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
            <div class="d-flex align-items-center gap-2">
                <img src="~/img/logo.svg" width="42" height="42" alt="" />
                <div><div class="h5 mb-0">MediVerify</div><div class="text-muted small">Dispensing receipt</div></div>
            </div>
            <div class="text-end small text-muted">
                <div>Receipt #@Model.DispensingRecordId</div>
                <div>@Model.DispensedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-6"><div class="text-muted small text-uppercase">Patient</div><div class="fw-semibold">@(rx?.Patient?.ApplicationUser?.FullName ?? "—")</div></div>
            <div class="col-6 text-end"><div class="text-muted small text-uppercase">Pharmacist</div><div class="fw-semibold">@(Model.Pharmacist?.FullName ?? "—")</div></div>
        </div>
        <table class="table">
            <thead><tr><th>Medicine</th><th class="text-end">Quantity</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Items ?? new List<DispensedItem>())
            {
                <tr><td>@(item.Medicine?.MedicineName ?? "—")</td><td class="text-end">@item.Quantity</td></tr>
            }
            </tbody>
        </table>
        <div class="text-muted small mt-4">Prescription @rx?.PrescriptionNumber · Status @rx?.Status</div>
    </div>
</div>
