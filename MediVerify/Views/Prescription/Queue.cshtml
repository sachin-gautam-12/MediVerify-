@model IEnumerable<Prescription>
@{
    ViewData["Title"] = "Verification Queue";
    var list = Model?.ToList() ?? new List<Prescription>();
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Verification queue</h1>
        <p class="text-muted mb-0">Submitted prescriptions waiting for a pharmacist decision.</p>
    </div>
    <a class="btn btn-outline-secondary" href="/Prescription/History"><i class="bi bi-clock-history me-1"></i>History</a>
</div>
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <input class="form-control form-control-sm" style="width:260px" placeholder="Search queue…" data-table-search="#queueTable" />
        <span class="text-muted small">@list.Count waiting</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-sortable mb-0" id="queueTable" data-page-size="10">
            <thead><tr><th data-sort>Number</th><th data-sort>Patient</th><th data-sort>Doctor</th><th data-sort>Submitted</th><th class="text-end">Action</th></tr></thead>
            <tbody>
            @if (!list.Any())
            {
                <tr><td colspan="5"><div class="empty-state"><i class="bi bi-clipboard2-check"></i>No prescriptions waiting for verification.</div></td></tr>
            }
            @foreach (var rx in list)
            {
                <tr>
                    <td class="fw-semibold">@rx.PrescriptionNumber</td>
                    <td>@(rx.Patient?.ApplicationUser?.FullName ?? "—")</td>
                    <td>@(rx.Doctor?.FullName ?? "—")</td>
                    <td class="text-muted">@((rx.UpdatedAt ?? rx.CreatedAt).ToLocalTime().ToString("dd MMM, HH:mm"))</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" href="/Prescription/Details/@rx.PrescriptionId"><i class="bi bi-eye"></i></a>
                        <a class="btn btn-sm btn-primary" href="/Prescription/Verify/@rx.PrescriptionId"><i class="bi bi-shield-check me-1"></i>Verify</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
