@model Prescription
@{
    ViewData["Title"] = "Prescription " + Model.PrescriptionNumber;
    var alerts = ViewBag.SafetyAlerts as List<SafetyAlert> ?? new List<SafetyAlert>();
    var dispensing = ViewBag.DispensingRecord as DispensingRecord;
    var isDoctor = User.IsInRole("Doctor");
    var isPharmacist = User.IsInRole("Pharmacist");
    var isPatient = User.IsInRole("Patient");
    var statusOrder = new[] { "Draft", "Submitted", "Verified", "Dispensed" };
    var currentIndex = Array.IndexOf(statusOrder, Model.Status);
    if (Model.Status == "Rejected") currentIndex = 2;
}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h1 class="h3 mb-0">@Model.PrescriptionNumber</h1>
            <partial name="_StatusBadge" model="Model.Status" />
        </div>
        <p class="text-muted mb-0">Created @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" href="/Prescription"><i class="bi bi-arrow-left me-1"></i>Back</a>
        <a class="btn btn-outline-primary" href="/Prescription/Print/@Model.PrescriptionId" target="_blank"><i class="bi bi-printer me-1"></i>Print</a>
        @if (isDoctor && Model.Status == "Draft")
        {
            <a class="btn btn-outline-primary" href="/Prescription/Edit/@Model.PrescriptionId"><i class="bi bi-pencil me-1"></i>Edit</a>
            <form asp-action="Submit" asp-route-id="@Model.PrescriptionId" method="post" data-confirm="Submit this prescription for pharmacist verification?">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i>Submit</button>
            </form>
            <form asp-action="Delete" asp-route-id="@Model.PrescriptionId" method="post" data-confirm="Delete this draft permanently?">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
            </form>
        }
        @if (isPharmacist && Model.Status == "Submitted")
        {
            <a class="btn btn-primary" href="/Prescription/Verify/@Model.PrescriptionId"><i class="bi bi-shield-check me-1"></i>Verify</a>
        }
        @if (isPharmacist && Model.Status == "Verified")
        {
            <a class="btn btn-success" href="/Prescription/Dispense/@Model.PrescriptionId"><i class="bi bi-box-seam me-1"></i>Dispense</a>
        }
        @if (dispensing != null)
        {
            <a class="btn btn-outline-success" href="/Prescription/Receipt/@Model.PrescriptionId"><i class="bi bi-receipt me-1"></i>Receipt</a>
        }
    </div>
</div>

@if (Model.Status == "Rejected" && !string.IsNullOrWhiteSpace(Model.RejectionReason))
{
    <div class="alert alert-danger"><strong>Rejected:</strong> @Model.RejectionReason</div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header">Prescription details</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6"><div class="text-muted small">Patient</div><div class="fw-semibold">@(Model.Patient?.ApplicationUser?.FullName ?? "—")</div></div>
                    <div class="col-md-6"><div class="text-muted small">Doctor</div><div class="fw-semibold">@(Model.Doctor?.FullName ?? "—")</div></div>
                    <div class="col-md-6"><div class="text-muted small">Prescription date</div><div>@Model.PrescriptionDate.ToString("dd MMM yyyy")</div></div>
                    <div class="col-md-6"><div class="text-muted small">Valid until</div><div>@(Model.ValidUntil?.ToString("dd MMM yyyy") ?? "—")</div></div>
                    <div class="col-12"><div class="text-muted small">Notes</div><div>@(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</div></div>
                </div>
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-capsule me-1"></i>Medicines</div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th>Medicine</th><th>Qty</th><th>Days</th><th>Instructions</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Items ?? new List<PrescriptionItem>())
                    {
                        <tr>
                            <td class="fw-semibold">@(item.Medicine?.MedicineName ?? "—")</td>
                            <td>@item.Quantity</td>
                            <td>@item.Duration</td>
                            <td>@item.PrescribedInstructions</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        @if (alerts.Any())
        {
            <div class="card mb-3">
                <div class="card-header text-danger"><i class="bi bi-shield-exclamation me-1"></i>Safety alerts</div>
                <div class="list-group list-group-flush">
                    @foreach (var alert in alerts)
                    {
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between">
                                <strong>@alert.AlertType</strong>
                                <span class="badge-status @(alert.Severity == "High" ? "badge-out" : alert.Severity == "Moderate" ? "badge-low" : "badge-ok")">@alert.Severity</span>
                            </div>
                            <div class="small text-muted">@alert.Description</div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">Status timeline</div>
            <div class="card-body">
                <ul class="mv-timeline">
                    <li>
                        <div class="fw-semibold">Created</div>
                        <div class="small text-muted">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div>
                    </li>
                    <li>
                        <div class="fw-semibold">Submitted</div>
                        <div class="small text-muted">@(currentIndex >= 1 ? "Sent for verification" : "Not submitted yet")</div>
                    </li>
                    <li>
                        <div class="fw-semibold">@(Model.Status == "Rejected" ? "Rejected" : "Verified")</div>
                        <div class="small text-muted">@(Model.VerifiedAt?.ToLocalTime().ToString("dd MMM yyyy, HH:mm") ?? (currentIndex >= 2 ? "Completed" : "Pending"))</div>
                    </li>
                    <li>
                        <div class="fw-semibold">Dispensed</div>
                        <div class="small text-muted">@(Model.DispensedAt?.ToLocalTime().ToString("dd MMM yyyy, HH:mm") ?? "Pending")</div>
                    </li>
                </ul>
            </div>
        </div>
        @if (dispensing != null)
        {
            <div class="card">
                <div class="card-header">Dispensing</div>
                <div class="card-body small">
                    <div class="d-flex justify-content-between"><span class="text-muted">Dispensed at</span><span>@dispensing.DispensedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span></div>
                    <hr />
                    @foreach (var item in dispensing.Items)
                    {
                        <div class="d-flex justify-content-between"><span>@(item.Medicine?.MedicineName ?? "—")</span><span>@item.Quantity</span></div>
                    }
                </div>
            </div>
        }
    </div>
</div>
