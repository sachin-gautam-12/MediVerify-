@model PrescriptionCreateViewModel
@{
    ViewData["Title"] = "Edit Draft";
    var patients = ViewBag.Patients as List<Patient> ?? new List<Patient>();
    var medicines = ViewBag.Medicines as List<Medicine> ?? new List<Medicine>();
    var items = Model.Items != null && Model.Items.Count > 0 ? Model.Items : new List<PrescriptionItemViewModel> { new() };
    var id = ViewContext.RouteData.Values["id"];
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Edit draft</h1>
        <p class="text-muted mb-0">@Model.PrescriptionNumber</p>
    </div>
    <a class="btn btn-outline-secondary" href="/Prescription/Details/@id">Back</a>
</div>
<form asp-action="Edit" asp-route-id="@id" method="post" data-spinner>
    @Html.AntiForgeryToken()
    <div class="card mb-3">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="row g-3">
                <div class="col-md-5">
                    <label asp-for="PatientId" class="form-label">Patient</label>
                    <select asp-for="PatientId" class="form-select">
                        @foreach (var p in patients)
                        {
                            <option value="@p.PatientId" selected="@(p.PatientId == Model.PatientId)">@(p.ApplicationUser?.FullName ?? ("Patient #" + p.PatientId))</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="PrescriptionDate" class="form-label"></label>
                    <input asp-for="PrescriptionDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="ValidUntil" class="form-label"></label>
                    <input asp-for="ValidUntil" type="date" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-capsule me-1"></i>Medicines</span>
            <button type="button" class="btn btn-sm btn-outline-primary" id="addRow"><i class="bi bi-plus-lg"></i> Add row</button>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th style="min-width:240px">Medicine</th><th style="width:120px">Qty</th><th style="width:130px">Days</th><th style="min-width:220px">Instructions</th><th style="min-width:180px">Notes</th><th></th></tr></thead>
                <tbody id="itemsBody">
                @for (var i = 0; i < items.Count; i++)
                {
                    <tr>
                        <td>
                            <select name="Items[@i].MedicineId" class="form-select form-select-sm">
                                <option value="">Select medicine…</option>
                                @foreach (var m in medicines)
                                {
                                    <option value="@m.MedicineId" selected="@(m.MedicineId == items[i].MedicineId)">@m.MedicineName</option>
                                }
                            </select>
                        </td>
                        <td><input name="Items[@i].Quantity" value="@items[i].Quantity" type="number" min="0.01" step="0.01" class="form-control form-control-sm" /></td>
                        <td><input name="Items[@i].Duration" value="@items[i].Duration" type="number" min="1" max="3650" class="form-control form-control-sm" /></td>
                        <td><input name="Items[@i].Instructions" value="@items[i].Instructions" class="form-control form-control-sm" /></td>
                        <td><input name="Items[@i].Notes" value="@items[i].Notes" class="form-control form-control-sm" /></td>
                        <td><button type="button" class="btn btn-sm btn-outline-danger removeRow"><i class="bi bi-trash"></i></button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save changes</button>
    <a class="btn btn-outline-secondary" href="/Prescription/Details/@id">Cancel</a>
</form>
<template id="rowTemplate">
    <tr>
        <td>
            <select name="Items[__i__].MedicineId" class="form-select form-select-sm">
                <option value="">Select medicine…</option>
                @foreach (var m in medicines)
                {
                    <option value="@m.MedicineId">@m.MedicineName</option>
                }
            </select>
        </td>
        <td><input name="Items[__i__].Quantity" type="number" min="0.01" step="0.01" value="1" class="form-control form-control-sm" /></td>
        <td><input name="Items[__i__].Duration" type="number" min="1" max="3650" value="7" class="form-control form-control-sm" /></td>
        <td><input name="Items[__i__].Instructions" class="form-control form-control-sm" /></td>
        <td><input name="Items[__i__].Notes" class="form-control form-control-sm" /></td>
        <td><button type="button" class="btn btn-sm btn-outline-danger removeRow"><i class="bi bi-trash"></i></button></td>
    </tr>
</template>
@section Scripts {
<script>
    (function () {
        const body = document.getElementById('itemsBody');
        const template = document.getElementById('rowTemplate').innerHTML;
        function reindex() {
            Array.from(body.querySelectorAll('tr')).forEach(function (row, i) {
                row.querySelectorAll('[name]').forEach(function (el) {
                    el.name = el.name.replace(/Items\[\d+\]/, 'Items[' + i + ']');
                });
            });
        }
        document.getElementById('addRow').addEventListener('click', function () {
            body.insertAdjacentHTML('beforeend', template.replace(/__i__/g, body.querySelectorAll('tr').length));
            reindex();
        });
        body.addEventListener('click', function (e) {
            const btn = e.target.closest('.removeRow');
            if (!btn || body.querySelectorAll('tr').length === 1) return;
            btn.closest('tr').remove();
            reindex();
        });
    })();
</script>
}
